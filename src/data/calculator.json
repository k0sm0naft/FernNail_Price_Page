{
  "_doc": "Each option's label comes from one of three sources, in priority order: 1) labelFromCategory → prices.categories[*].labels[lang], 2) labelFromItem → prices.categories[*].items[*].labels[lang], 3) labelKey → locales/{lang}.json. This keeps category and item names in prices.json as the single source of truth; only labels that don't already exist there live in locales (e.g. 'Both', 'No coating'). showIf + type:'multi' are reserved for Phase 7; the renderer currently shows every type:'single' step.",
  "steps": [
    {
      "id": "service",
      "type": "single",
      "questionKey": "calc.q1.t",
      "options": [
        { "id": "manicure", "labelFromCategory": "manicure", "addsItems": ["manicure-bare"] },
        { "id": "pedicure", "labelFromCategory": "pedicure", "addsItems": ["pedicure-full"] },
        { "id": "both",     "labelKey": "calc.q1.opts.both", "addsItems": ["manicure-bare", "pedicure-full"] }
      ]
    },
    {
      "id": "length",
      "type": "single",
      "questionKey": "calc.q2.t",
      "showIf": { "step": "service", "in": ["manicure", "both"] },
      "options": [
        { "id": "short", "labelKey": "calc.q2.opts.short", "addsItems": ["gel-correction-1-2"],   "replacesItems": ["manicure-bare"], "requires": ["manicure-bare"] },
        { "id": "long",  "labelKey": "calc.q2.opts.long",  "addsItems": ["gel-correction-3plus"], "replacesItems": ["manicure-bare"], "requires": ["manicure-bare"] },
        { "id": "ext",   "labelKey": "calc.q2.opts.ext",   "addsItems": ["extension-3plus"],       "replacesItems": ["manicure-bare"], "requires": ["manicure-bare"] }
      ]
    },
    {
      "id": "coverage",
      "type": "single",
      "questionKey": "calc.q3.t",
      "options": [
        { "id": "none",   "labelKey": "calc.q3.opts.none",   "addsItems": [] },
        { "id": "single", "labelKey": "calc.q3.opts.single", "addsItems": [] },
        { "id": "french", "labelFromItem": "french-10",      "addsItems": ["french-10"] }
      ]
    },
    {
      "id": "addons",
      "type": "single",
      "questionKey": "calc.q4.t",
      "options": [
        { "id": "slider", "labelKey": "calc.q4.opts.slider", "addsItems": ["slider-painting"] },
        { "id": "rubin",  "labelKey": "calc.q4.opts.rubin",  "addsItems": ["rub-in-gradient"] },
        { "id": "seal",   "labelKey": "calc.q4.opts.seal",   "addsItems": ["seal-protect"] },
        { "id": "none",   "labelKey": "calc.q4.opts.none",   "addsItems": [] }
      ]
    }
  ]
}
